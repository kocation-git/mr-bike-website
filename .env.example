NODE_ENV=development
PORT=3000

# SMTP settings (Gmail: use App Password, not your account password)
# To get an App Password: myaccount.google.com > Security > 2FA > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email addresses
OWNER_EMAIL=fernando.pcn@gmail.com
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Mr. Bike Copenhagen

# Admin dashboard password
ADMIN_PASSWORD=change-this-password

# reCAPTCHA v3 (get keys at https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Base URL (used for links in emails)
BASE_URL=http://localhost:3000

# Google Review link (get from Google Business > Share review link)
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_LINK
